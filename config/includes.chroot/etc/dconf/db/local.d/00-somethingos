[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'
enable-hot-corners=true
clock-show-weekday=true
clock-format='24h'
show-battery-percentage=true
enable-animations=true

[org/gnome/desktop/wm/preferences]
titlebar-font='Inter Bold 11'
button-layout='appmenu:minimize,close'
num-workspaces=4
audible-bell=false

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/somethingos/shadow.png'
picture-uri-dark='file:///usr/share/backgrounds/somethingos/shadow.png'
picture-options='zoom'
primary-color='#07080b'
secondary-color='#07080b'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/somethingos/shadow.png'
picture-options='zoom'
primary-color='#07080b'
lock-enabled=true
lock-delay=uint32 0

[org/gnome/desktop/session]
idle-delay=uint32 300

[org/gnome/desktop/privacy]
report-technical-problems=false
send-software-usage-stats=false
remember-recent-files=false
remove-old-trash-files=true
remove-old-temp-files=true
old-files-age=uint32 7
# usb-protection drives usbguard over D-Bus, whose polkit policy demands
# admin auth — it blocked the live desktop with an unanswerable
# "This USBGuard action needs authorization" prompt. usbguard is no longer
# shipped (see docs/HARDENING.md), so this must stay off.
usb-protection=false

[org/gnome/desktop/notifications]
show-in-lock-screen=false

[org/gnome/desktop/search]
disable-external=true

[org/gnome/desktop/sound]
event-sounds=false
allow-volume-above-100-percent=false

[org/gnome/mutter]
dynamic-workspaces=true
edge-tiling=true
workspaces-only-on-primary=true

[org/gnome/shell]
favorite-apps=['org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'firefox-esr.desktop', 'org.gnome.Settings.desktop', 'ring-rush.desktop', 'something-welcome.desktop']
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'ubuntu-appindicators@ubuntu.com', 'apps-menu@gnome-shell-extensions.gcampax.github.com']
disable-user-extensions=false

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=false
dash-max-icon-size=48
unity-backlit-items=false
transparency-mode='DYNAMIC'
background-opacity=0.62
custom-background-color=true
background-color='#11141a'
custom-theme-shrink=true
show-mounts=false
show-trash=false
show-show-apps-button=true
hot-keys=false
intellihide=true
intellihide-mode='ALL_WINDOWS'
click-action='focus-minimize-or-previews'
multi-monitor=false
running-indicator-style='DOTS'
apply-custom-theme=false
isolate-workspaces=false
animate-show-apps=true

[org/gnome/terminal/legacy]
theme-variant='dark'
default-show-menubar=false

[org/gnome/terminal/legacy/profiles:]
list=['b1dcc9dd-5262-4d8d-a863-c897e6d979b9']
default='b1dcc9dd-5262-4d8d-a863-c897e6d979b9'

[org/gnome/terminal/legacy/profiles:/:b1dcc9dd-5262-4d8d-a863-c897e6d979b9]
