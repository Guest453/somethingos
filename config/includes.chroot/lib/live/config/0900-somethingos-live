#!/bin/sh
# SomethingOS: never idle-lock a live session.
#
# The installed system keeps lock-enabled=true and idle-delay=300 from
# /etc/dconf/db/local.d/00-somethingos (see docs/HARDENING.md). That is the
# right default once a user owns the machine and knows their password.
#
# In a live session it is a trap. live-config gives `someone` a password that
# is documented nowhere in this project, so after five idle minutes the user
# is staring at a lock screen they cannot answer, with no recourse but a hard
# reboot that discards the whole session.
#
# live-config only runs this in live sessions, and Calamares installs by
# unpacking the squashfs rather than copying this overlay, so an installed
# SomethingOS is unaffected.

set -e

mkdir -p /etc/dconf/db/local.d
cat > /etc/dconf/db/local.d/01-somethingos-live <<'DCONF'
[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false
DCONF

dconf update 2>/dev/null || true

# Same for the Plasma flavour's screen locker.
mkdir -p /etc/xdg
cat > /etc/xdg/kscreenlockerrc <<'KDE'
[Daemon]
Autolock=false
LockOnResume=false
KDE

echo "live-config: somethingos live tweaks applied"
