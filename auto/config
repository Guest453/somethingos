#!/bin/sh
# live-build configuration for SomethingOS.
# Invoked by `lb config` and by scripts/build.sh.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
DESKTOP="${DESKTOP:-gnome}"
ARCH="${ARCH:-amd64}"
VERSION="${VERSION:-$(cat "$ROOT/VERSION")}"
CODENAME="${CODENAME:-shadow}"
DIST="${DIST:-bookworm}"

case "$DESKTOP" in
  gnome|plasma) ;;
  *) echo "auto/config: DESKTOP must be gnome or plasma (got '$DESKTOP')" >&2; exit 2 ;;
esac

# Flavour-specific package list.
# The flavour sources live in config/flavours/ and NOT in config/package-lists/,
# because live-build installs every config/package-lists/*.list on every build —
# leaving them there installed GNOME and Plasma packages together.
mkdir -p "$ROOT/config/package-lists"
rm -f "$ROOT/config/package-lists/flavour-"*.list.chroot
cp "$ROOT/config/flavours/${DESKTOP}.list" \
   "$ROOT/config/package-lists/flavour-${DESKTOP}.list.chroot"

# Calamares desktop-environment hint used by the installer module
mkdir -p "$ROOT/config/includes.chroot/etc/somethingos"
printf '%s\n' "$DESKTOP" > "$ROOT/config/includes.chroot/etc/somethingos/desktop"
printf '%s\n' "$VERSION" > "$ROOT/config/includes.chroot/etc/somethingos/version"
printf '%s\n' "$CODENAME" > "$ROOT/config/includes.chroot/etc/somethingos/codename"

BOOTAPPEND="boot=live components quiet splash hostname=somethingos username=someone user-fullname=Someone timezone=UTC utc=yes"

# Squashfs compression: zstd decompresses faster than xz and the live
# kernel does not care. We pick zstd at level 3 (zstd's default) which is
# the sweet spot — about 3x faster mksquashfs runtime vs xz at a small
# (~10%) cost in output size on Debian chroots. Overridable from the
# env: SQUASHFS_COMP=xz make iso
SQUASHFS_COMP="${SQUASHFS_COMP:-zstd}"
SQUASHFS_LEVEL="${SQUASHFS_LEVEL:-3}"

# Checksums: live-build's default is to walk the binary stage and write
# a SHA-256 manifest of every file in the ISO. On a 1.5 GB hybrid ISO
# that takes 1-3 minutes of redundant I/O on top of the squashfs step
# (which already has its own internal integrity blocks). We disable it
# by default to keep the build fast. Re-enable with CHECKSUMS=sha256 make
# iso if you want the post-build manifest for distribution channels.
CHECKSUMS="${CHECKSUMS:-none}"

lb config noauto \
  --mode debian \
  --system live \
  --distribution "$DIST" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --architectures "$ARCH" \
  --binary-images iso-hybrid \
  --iso-application "SomethingOS" \
  --iso-publisher "SomethingOS Project" \
  --iso-volume "SomethingOS ${VERSION} ${CODENAME}" \
  --image-name "somethingos-${VERSION}-${CODENAME}-${DESKTOP}" \
  --bootappend-live "$BOOTAPPEND" \
  --bootappend-live-failsafe "boot=live components memtest noapic noapm nodma nomce nolapic nomodeset nosmp nosplash vga=normal hostname=somethingos username=someone" \
  --debian-installer none \
  --firmware-binary true \
  --firmware-chroot true \
  --updates true \
  --security true \
  --backports false \
  --mirror-bootstrap "${MIRROR:-http://deb.debian.org/debian/}" \
  --mirror-binary "${MIRROR:-http://deb.debian.org/debian/}" \
  --mirror-binary-security "${MIRROR_SECURITY:-http://security.debian.org/}" \
  --keyring-packages "debian-archive-keyring" \
  --linux-flavours amd64 \
  --linux-packages "linux-image linux-headers" \
  --apt-indices "${APT_INDICES:-true}" \
  --apt-recommends true \
  --apt-source-archives false \
  --chroot-squashfs-compression-type "$SQUASHFS_COMP" \
  --chroot-squashfs-compression-level "$SQUASHFS_LEVEL" \
  --checksums "$CHECKSUMS" \
  --win32-loader false \
  --memtest none \
  --zsync false \
  --clean \
  --debug \
  --color \
  --interactive false \
  --utc-time true
